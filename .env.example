# ============================================================================
#  Configuration Template (Copy to .env and fill in your values)
# ============================================================================

# SolarEdge Inverter (Modbus TCP)
INVERTER_IP=192.168.1.100
MODBUS_PORT=502
RATED_AC_WATTS=7600

# Emporia Vue Cloud Credentials
EMPORIA_USER=your_email@example.com
EMPORIA_PASS=your_emporia_password

# Energy Rates ($/kWh)
IMPORT_RATE_KWH=0.14
EXPORT_RATE_KWH=0.01

# Polling Intervals (ms) - Can also be changed live from HA dashboard sliders
MODBUS_POLL_INTERVAL_MS=1000
EMPORIA_POLL_INTERVAL_MS=2000
POLL_INTERVAL_MS=2000

# Home Assistant & MQTT Broker
HA_IP=192.168.1.50
HA_MQTT_BROKER=mqtt://192.168.1.50:1883
HA_MQTT_USER=solar
HA_MQTT_PASS=your_mqtt_password
HA_SAMBA_PATH=\\homeassistant.local\addons\ha-addon\solar_energy_monitor

# CPS Energy Smart Meter (AMI) Portal
CPS_USER=your_cps_username
CPS_PASS=your_cps_password
CPS_METER_ID=your_meter_id
